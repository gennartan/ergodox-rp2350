mainmenu "Ergodox custom main menu"

choice ERGODOX_KEYBOARD_HAND
    prompt "Keyboard hand"
    default ERGODOX_KEYBOARD_HAND_RIGHT

config ERGODOX_KEYBOARD_HAND_LEFT
    bool "Left hand"
    help
      Build firmware using the left-hand side of the selected layout.

config ERGODOX_KEYBOARD_HAND_RIGHT
    bool "Right hand"
    help
      Build firmware using the right-hand side of the selected layout.

endchoice

choice ERGODOX_KEYBOARD_LAYOUT
    prompt "Keyboard layout"
    default ERGODOX_KEYBOARD_LAYOUT_SIMPLE

config ERGODOX_KEYBOARD_LAYOUT_SIMPLE
    bool "Simple layered layout"
    help
      Default QWERTY-style layout with navigation, symbol, and function layers.

config ERGODOX_KEYBOARD_LAYOUT_CUSTOM
    bool "My custom layout"
    help
      Custom layout

endchoice

source "Kconfig.zephyr"
