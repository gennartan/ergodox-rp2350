mainmenu "Ergodox custom main menu"

choice ERGODOX_KEYBOARD_HAND
    prompt "Keyboard hand"
    default ERGODOX_KEYBOARD_HAND_RIGHT

config ERGODOX_KEYBOARD_HAND_LEFT
    bool "Left hand"
    help
      Build firmware using the left-hand side of the selected layout.

config ERGODOX_KEYBOARD_HAND_RIGHT
    bool "Right hand"
    help
      Build firmware using the right-hand side of the selected layout.

endchoice

config ERGODOX_SPLIT_UART
    bool "Enable split keyboard UART transport"
    default y
    select SERIAL
    select UART_INTERRUPT_DRIVEN
    help
      Enable the UART transport used to forward raw key events from the
      non-USB half to the USB-connected half.

config ERGODOX_SPLIT_UART_BAUDRATE
    int "Split UART baudrate"
    default 1000000
    depends on ERGODOX_SPLIT_UART

config ERGODOX_USB_READY_TIMEOUT_MS
    int "USB ready timeout before falling back to UART"
    default 1500
    help
      Time to wait at boot for the USB HID interface to become ready. If USB
      initialization fails or the interface is not ready before this timeout,
      the firmware acts as the UART-sender half.

choice ERGODOX_KEYBOARD_LAYOUT
    prompt "Keyboard layout"
    default ERGODOX_KEYBOARD_LAYOUT_SIMPLE

config ERGODOX_KEYBOARD_LAYOUT_SIMPLE
    bool "Simple layered layout"
    help
      Default QWERTY-style layout with navigation, symbol, and function layers.

config ERGODOX_KEYBOARD_LAYOUT_CUSTOM
    bool "My custom layout"
    help
      Custom layout

endchoice

source "Kconfig.zephyr"
